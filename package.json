{
  "name": "aplf-goto-definition",
  "displayName": "APLF Go To Definition",
  "description": "F12 go-to-definition for .aplf and .sysobject files",
  "version": "0.0.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iskandermae/apl-vs-extension"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "OptimaSystems.vscode-apl-language"
  ],
  "activationEvents": [
    "onLanguage:apl",
    "onLanguage:sysobject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sysobject",
        "extensions": [
          ".sysobject"
        ]
      }
    ],
    "commands": [
      {
        "command": "aplf.gotoDefinition",
        "title": "Go to Definition File"
      },
      {
        "command": "aplf.findUsage",
        "title": "Find Usage"
      },
      {
        "command": "aplf.insertSymbol",
        "title": "Insert APL Symbol"
      },
      {
        "command": "aplf.toggleAplSymbols",
        "title": "Toggle APL Symbol Shortcuts"
      },
      {
        "command": "aplf.pickAplSymbol",
        "title": "Pick APL Symbol"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aplf.gotoDefinition",
          "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject')",
          "group": "navigation"
        },
        {
          "command": "aplf.findUsage",
          "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject')",
          "group": "navigation"
        },
        {
          "command": "aplf.pickAplSymbol",
          "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject')",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Find Usage Folders",
      "properties": {
        "aplf.findUsageFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "src/Business/CorporateActions"
          ],
          "description": "Workspace-relative folders to search in when using Find Usage."
        },
        "aplf.aplSymbolsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable APL symbol keyboard shortcuts. Toggle with the 'Toggle APL Symbol Shortcuts' command."
        },
        "aplf.aplSymbolsFile": {
          "type": "string",
          "default": "",
          "description": "Absolute or workspace-relative path to a JSON file with additional APL symbols for the picker. Same format as apl-symbols.json: [{\"info\": \"ctrl+alt+a\", \"symbol\": \"⍺\"}]"
        }
      }
    },
    "keybindings": [
      {
        "command": "aplf.gotoDefinition",
        "key": "f12",
        "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject')"
      },
      {
        "command": "aplf.pickAplSymbol",
        "key": "ctrl+shift+space",
        "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject')"
      },
      {
        "command": "aplf.insertSymbol",
        "args": {
          "symbol": "⍬"
        },
        "key": "ctrl+shift+=",
        "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject') && aplf.aplSymbolsEnabled"
      },
      {
        "command": "aplf.insertSymbol",
        "args": {
          "symbol": "←"
        },
        "key": "ctrl+]",
        "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject') && aplf.aplSymbolsEnabled"
      },
      {
        "command": "aplf.insertSymbol",
        "args": {
          "symbol": "⍳"
        },
        "key": "ctrl+i",
        "when": "editorTextFocus && (editorLangId == 'apl' || editorLangId == 'sysobject') && aplf.aplSymbolsEnabled"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest",
    "test:unit": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.75.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
